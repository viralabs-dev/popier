# Shared look for every demo: the noite theme's colors around the terminal.
Set Shell "bash"
Set FontSize 18
Set FontFamily "JetBrains Mono"
Set Width 1600
Set Height 860
Set Padding 24
Set Margin 0
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 45ms
Set Theme { "name": "popier-noite", "background": "#0e1016", "foreground": "#e7eaf0", "cursor": "#ffb454", "selection": "#262d3d", "black": "#151821", "red": "#ff6b6b", "green": "#4fd18b", "yellow": "#ffc65c", "blue": "#62b6ff", "magenta": "#b89fc0", "cyan": "#62b6ff", "white": "#e7eaf0", "brightBlack": "#5d6578", "brightRed": "#ff6b6b", "brightGreen": "#4fd18b", "brightYellow": "#ffb454", "brightBlue": "#62b6ff", "brightMagenta": "#b89fc0", "brightCyan": "#62b6ff", "brightWhite": "#ffffff" }
